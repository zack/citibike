{
  "name": "citibike-station-data",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24",
    "pnpm": "please-use-npm",
    "yarn": "please-use-npm"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "npx prisma db seed",
